{# Trunk + EtherChannel between COREtaas and COREbaba (same on both switches) #}
!
! --- Trunk ports switch to switch + EtherChannel LACP (3 cables > 1) ---
! (2960 says "% Invalid input" on the encapsulation line - that's normal, it only does dot1q)
 int range {{ d.uplink.ports }}
  no shutdown
  switchport trunk encapsulation dot1q
  switchport mode trunk
  channel-group {{ d.uplink.channel_group }} mode active
  channel-protocol lacp
 exit
