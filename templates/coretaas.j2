! ===== {{ hostname }}  (pod {{ pod }}) - TASK1 collapsed backbone =====
! Console cable in, paste this (or let the SecureCRT script type it).
! Then from any PC in VLAN 1:  telnet 10.{{ pod }}.1.{{ octet }}   password: {{ d.line_password }}
{% include "_base.j2" %}
!
! --- SVIs ---
{% include "_svis.j2" %}
!
! --- VLANs (so SVIs 10/50/100 come up instead of staying down) ---
{% for vid, v in d.vlans.items() if vid != "1" %}
 vlan {{ vid }}
  name {{ v.name }}
{% endfor %}
 exit
!
! --- Telnet from other VLANs goes back through COREbaba ---
 ip default-gateway 10.{{ pod }}.1.{{ hosts.corebaba }}
{% if uplink %}
{% include "_uplink.j2" %}
{% endif %}
end
{% if save %}
write memory
{% endif %}
!
! --- Check ---
! show ip int brief
{% if uplink %}
! show int trunk
! show etherchannel summary
! show int po{{ d.uplink.channel_group }} | inc BW
{% endif %}
! ping 10.{{ pod }}.1.{{ hosts.corebaba }}
