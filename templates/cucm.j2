! ===== {{ hostname }}  (pod {{ pod }}) - generated by cisco-ai-builder =====
{% include "_base.j2" %}
!
 int Fa0/0
  no shutdown
  ip add 10.{{ pod }}.100.{{ octet }} 255.255.255.0
 exit
 ip route 0.0.0.0 0.0.0.0 10.{{ pod }}.100.{{ hosts.corebaba }}
!
! --- CallManager Express ---
 no telephony-service
 telephony-service
  no auto assign
  no auto-reg-ephone
  max-ephones {{ [phones|length, 5]|max }}
  max-dn 20
  ip source-address 10.{{ pod }}.100.{{ octet }} port 2000
  create cnf-files
 exit
{% for ph in phones %}
 ephone-dn {{ loop.index }}
  number {{ ph.number }}
{% endfor %}
{% for ph in phones %}
{% if ph.mac %}
 ephone {{ loop.index }}
  mac-address {{ ph.mac }}
  type {{ d.phone_model }}
  button 1:{{ loop.index }}
  restart
{% else %}
 ! phone {{ ph.number }}: no MAC given -> add "ephone {{ loop.index }} / mac-address xxxx.xxxx.xxxx / button 1:{{ loop.index }}" later
{% endif %}
{% endfor %}
end
{% if save %}
write memory
{% endif %}
!
! --- Verify ---
! show ephone registered
! show telephony-service ephone-dn
