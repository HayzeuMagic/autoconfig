! ===== {{ hostname }}  (pod {{ pod }}) - TASK1 collapsed backbone (leaf / L3 switch) =====
! Console cable in, paste this (or let the SecureCRT script type it).
! Then from any PC in VLAN 1:  telnet 10.{{ pod }}.1.{{ octet }}   password: {{ d.line_password }}
{% include "_base.j2" %}
 ip routing
!
! --- Uplink to EDGE + SVIs ---
 int Gi0/1
  no shutdown
  no switchport
  ip add 10.{{ pod }}.{{ pod }}.{{ octet }} 255.255.255.0
 exit
{% include "_svis.j2" %}
{% if uplink %}
{% include "_uplink.j2" %}
{% endif %}
!
! --- DHCP ---
{% for vid, v in d.vlans.items() %}
 ip dhcp excluded-address 10.{{ pod }}.{{ vid }}.1 10.{{ pod }}.{{ vid }}.{{ d.dhcp_exclude_up_to }}
{% endfor %}
{% for vid, v in d.vlans.items() %}
 ip dhcp pool {{ v.pool }}
  network 10.{{ pod }}.{{ vid }}.0 255.255.255.0
  default-router 10.{{ pod }}.{{ vid }}.{{ octet }}
  domain-name {{ v.domain }}
  dns-server 10.{{ pod }}.1.{{ d.dns_server_host }}
{% if vid == "100" %}
  option 150 ip 10.{{ pod }}.100.{{ hosts.cucm }}
{% endif %}
{% endfor %}
 exit
!
! --- VLANs ---
{% for vid, v in d.vlans.items() if vid != "1" %}
 vlan {{ vid }}
  name {{ v.name }}
{% endfor %}
{% for vid, name in d.extra_vlans.items() %}
 vlan {{ vid }}
  name {{ name }}
{% endfor %}
 exit
!
! --- Access points / Wi-Fi (VLAN 10) ---
{% for ap in access_points %}
 int {{ ap.port }}
{% if ap.ip %}
  description AP {{ ap.ip }}
{% endif %}
  switchport mode access
  switchport access vlan 10
{% endfor %}
!
! --- IP cameras (VLAN 50) ---
{% for cam in cameras %}
 int {{ cam.port }}
  description CAMERA {{ cam.ip }}
  switchport mode access
  switchport access vlan 50
{% endfor %}
!
! --- CUCM (VLAN 100) ---
 int {{ d.default_ports.cucm }}
  description CUCM 10.{{ pod }}.100.{{ hosts.cucm }}
  switchport mode access
  switchport access vlan 100
!
! --- IP phones (voice VLAN 100, PC behind the phone on VLAN 1) ---
{% for ph in phones %}
 int {{ ph.port }}
{% if ph.number %}
  description PHONE {{ ph.number }}
{% endif %}
  switchport mode access
  switchport voice vlan 100
  mls qos trust device cisco-phone
  switchport access vlan 1
{% endfor %}
 exit
!
! --- Camera MAC reservations (fixed IP) ---
{% for cam in cameras %}
{% if cam.client_id %}
 ip dhcp pool CAMERA{{ cam.ip.split('.')[-1] }}
  host {{ cam.ip }} 255.255.255.0
  client-identifier {{ cam.client_id }}
  default-router 10.{{ pod }}.50.{{ octet }}
{% else %}
 ! CAMERA{{ cam.ip.split('.')[-1] }} {{ cam.ip }}: no MAC given. Add "client-identifier 01xx.xxxx.xxxx.xx" later, or set the camera to static {{ cam.ip }} gw 10.{{ pod }}.50.{{ octet }}
{% endif %}
{% endfor %}
 exit
{% if block_cameras_from_wifi %}
!
! --- Block Wi-Fi users from camera web pages (VLAN access-map) ---
 no ip access-list extended BLOCK_camera
 ip access-list extended BLOCK_camera
{% for cam in cameras %}
  permit tcp any host {{ cam.ip }} eq 80
{% endfor %}
 exit
 vlan access-map BLOCK_CAM 10
  match ip address BLOCK_camera
  action drop
 vlan access-map BLOCK_CAM 20
  action forward
 exit
 vlan filter BLOCK_CAM vlan-list 10
{% endif %}
{% if default_route %}
!
! --- Default route to EDGE (so the switch can get out) ---
 ip route 0.0.0.0 0.0.0.0 10.{{ pod }}.{{ pod }}.{{ hosts.edge }}
{% endif %}
{% if ospf %}
!
! --- OSPF ---
 router ospf 1
  router-id 10.{{ pod }}.{{ pod }}.{{ octet }}
  network 10.{{ pod }}.0.0 0.0.255.255 area 0
 int Gi0/1
  ip ospf network point-to-point
{% endif %}
end
{% if save %}
write memory
{% endif %}
!
! --- Check ---
! show ip int brief
{% if uplink %}
! show int trunk
! show etherchannel summary
{% endif %}
! show vlan brief
! show ip dhcp binding
{% if ospf %}
! show ip ospf neighbor
{% endif %}
! ping 10.{{ pod }}.1.{{ hosts.coretaas }}
