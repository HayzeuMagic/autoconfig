! ===== {{ hostname }}  (pod {{ pod }}) - generated by cisco-ai-builder =====
{% include "_base.j2" %}
!
! --- Uplink + SVIs ---
 ip routing
 int Gi0/1
  no shutdown
  no switchport
  ip add 10.{{ pod }}.{{ pod }}.{{ octet }} 255.255.255.0
{% for vid, v in d.vlans.items() %}
 int vlan {{ vid }}
  no shutdown
  ip add 10.{{ pod }}.{{ vid }}.{{ octet }} 255.255.255.0
  description {{ v.pool }}
{% endfor %}
 exit
!
! --- VLANs ---
{% for vid, v in d.vlans.items() if vid != "1" %}
 vlan {{ vid }}
  name {{ v.name }}
{% endfor %}
 exit
!
! --- DHCP pools ---
{% for vid, v in d.vlans.items() %}
 ip dhcp excluded-address 10.{{ pod }}.{{ vid }}.1 10.{{ pod }}.{{ vid }}.{{ d.dhcp_exclude_up_to }}
{% endfor %}
{% for vid, v in d.vlans.items() %}
 ip dhcp pool {{ v.pool }}
  network 10.{{ pod }}.{{ vid }}.0 255.255.255.0
  default-router 10.{{ pod }}.{{ vid }}.{{ octet }}
  domain-name {{ v.domain }}
  dns-server 10.{{ pod }}.1.{{ d.dns_server_host }}
{% if vid == "100" %}
  option 150 ip 10.{{ pod }}.100.{{ d.host_octet.cucm }}
{% endif %}
{% endfor %}
 exit
{% if access_points %}
!
! --- Access points (VLAN 10) ---
{% for ap in access_points %}
 int {{ ap.port }}
  description AP {{ ap.ip or "" }}
  switchport mode access
  switchport access vlan 10
{% endfor %}
{% endif %}
{% if cameras %}
!
! --- IP cameras (VLAN 50) ---
{% for cam in cameras %}
 int {{ cam.port }}
  description CAMERA {{ cam.ip }}
  switchport mode access
  switchport access vlan 50
{% endfor %}
 exit
{% for cam in cameras %}
{% if cam.client_id %}
 ip dhcp pool CAMERA{{ cam.ip.split('.')[-1] }}
  host {{ cam.ip }} 255.255.255.0
  client-identifier {{ cam.client_id }}
  default-router 10.{{ pod }}.50.{{ octet }}
{% else %}
 ! CAMERA {{ cam.ip }}: no MAC given -> set the camera to static IP {{ cam.ip }}, gateway 10.{{ pod }}.50.{{ octet }}
{% endif %}
{% endfor %}
 exit
{% endif %}
{% if include_cucm_port %}
!
! --- CUCM uplink (VLAN 100) ---
 int {{ d.default_ports.cucm }}
  description CUCM 10.{{ pod }}.100.{{ d.host_octet.cucm }}
  switchport mode access
  switchport access vlan 100
{% endif %}
{% if phones %}
!
! --- IP phones (voice VLAN 100, PC behind phone on VLAN 1) ---
{% for ph in phones %}
 int {{ ph.port }}
  description PHONE {{ ph.number or "" }}
  switchport mode access
  switchport access vlan 1
  switchport voice vlan 100
  mls qos trust device cisco-phone
{% endfor %}
{% endif %}
{% if block_cameras_from_wifi and cameras %}
!
! --- Block Wi-Fi users from camera web pages (VLAN access-map) ---
 no ip access-list extended BLOCK_camera
 ip access-list extended BLOCK_camera
{% for cam in cameras %}
  permit tcp any host {{ cam.ip }} eq 80
{% endfor %}
 vlan access-map BLOCK_CAM 10
  match ip address BLOCK_camera
  action drop
 vlan access-map BLOCK_CAM 20
  action forward
 vlan filter BLOCK_CAM vlan-list 10
{% endif %}
end
!
! --- Verify ---
! show ip int brief
! show vlan brief
! show ip dhcp binding
{% if block_cameras_from_wifi and cameras %}
! show vlan filter
{% endif %}
