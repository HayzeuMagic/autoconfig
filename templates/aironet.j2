! ===== {{ hostname }}  (pod {{ pod }}) - generated by cisco-ai-builder =====
! From a PC: telnet {{ ap_ip }}
conf t
 default int dot11radio 0
 hostname {{ hostname }}
 dot11 ssid {{ wifi.ssid }}
  authentication open
  authentication key-management wpa
  wpa-psk ascii {{ wifi.password }}
  guest-mode
 int dot11radio 0
  no shut
  channel {{ wifi.channel }}
  encryption mode ciphers tkip
  ssid {{ wifi.ssid }}
  bridge-group 1
end
{% if save %}
write memory
{% endif %}
